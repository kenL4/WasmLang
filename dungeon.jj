
// Dungeon Crawler Auto-Player
// Map size: 80x24 (leaving bottom line for status)
var map[2000]; // 80 * 25
var player_x = 0;
var player_y = 0;
var goal_x = 0;
var goal_y = 0;
var coins = 0;
var level = 1;

// Upgrades
var has_monsters = 0;
var map_complexity = 1;

// Constants
var WIDTH = 80;
var HEIGHT = 24;
var TILE_EMPTY = 32; // ' '
var TILE_WALL = 35;  // '#'
var TILE_GOAL = 62;  // '>'
var TILE_PLAYER = 64; // '@'
var TILE_MONSTER = 77; // 'M'

func clear_map() {
  for (var i = 0; i < 2000; i = i + 1) {
    map[i] = TILE_WALL;
  }
}

func set_tile(x, y, tile) {
  if (x < 0) { return; }
  if (y < 0) { return; }
  if (x > 79) { return; }
  if (y > 23) { return; }
  map[y * 80 + x] = tile;
}

func get_tile(x, y) {
  if (x < 0) { return TILE_WALL; }
  if (y < 0) { return TILE_WALL; }
  if (x > 79) { return TILE_WALL; }
  if (y > 23) { return TILE_WALL; }
  return map[y * 80 + x];
}

func generate_room(x, y, w, h) {
  for (var ry = y; ry < y + h; ry = ry + 1) {
    for (var rx = x; rx < x + w; rx = rx + 1) {
      set_tile(rx, ry, TILE_EMPTY);
    }
  }
}

func rand_mod(n) {
  var r = random();
  var div = r / n;
  return r - div * n;
}

func generate_dungeon() {
  clear_map();
  
  // Simple generation: Random rooms
  var num_rooms = 5 + map_complexity * 2;
  var prev_x = 0;
  var prev_y = 0;
  
  for (var i = 0; i < num_rooms; i = i + 1) {
    var w = 5 + rand_mod(10); // 5-14
    var h = 4 + rand_mod(6);   // 4-9
    var x = 1 + rand_mod(WIDTH - w - 2);
    var y = 1 + rand_mod(HEIGHT - h - 2);
    
    generate_room(x, y, w, h);
    
    if (i > 0) {
      // Connect to previous room (simple corridor)
      // Horizontal then Vertical
      var cx = prev_x;
      var cy = prev_y;
      while (cx != x) {
        set_tile(cx, cy, TILE_EMPTY);
        if (cx < x) { cx = cx + 1; }
        else { cx = cx - 1; }
      }
      while (cy != y) {
        set_tile(cx, cy, TILE_EMPTY);
        if (cy < y) { cy = cy + 1; }
        else { cy = cy - 1; }
      }
    } else {
      // Start pos
      player_x = x + 1;
      player_y = y + 1;
    }
    
    prev_x = x + w / 2;
    prev_y = y + h / 2;
  }
  
  // Place goal in the last room center
  goal_x = prev_x;
  goal_y = prev_y;
  set_tile(goal_x, goal_y, TILE_GOAL);
  
  // Add monsters if upgraded
  if (has_monsters) {
    for (var m = 0; m < 5; m = m + 1) {
       var mx = rand_mod(78) + 1;
       var my = rand_mod(22) + 1;
       if (get_tile(mx, my) == TILE_EMPTY) {
         set_tile(mx, my, TILE_MONSTER);
       }
    }
  }
}

func draw_status() {
  // Draw status line at y=24
  for (var i = 0; i < 80; i = i + 1) {
    set_char(i, 24, 32); // Clear
  }
  
  // Draw Coins
  for (var c = 0; c < coins; c = c + 1) {
    if (c < 70) { set_char(c, 24, 36); } // '$'
  }
  
  // Draw Level as '*'
  for (var l = 0; l < level; l = l + 1) {
    set_char(79 - l, 24, 42); // '*'
  }
}

func draw() {
  // Draw map
  for (var y = 0; y < HEIGHT; y = y + 1) {
    for (var x = 0; x < WIDTH; x = x + 1) {
      var t = map[y * 80 + x];
      if (x == player_x) {
        if (y == player_y) {
          t = TILE_PLAYER;
        }
      }
      set_char(x, y, t);
    }
  }
  draw_status();
}

func move_player() {
  var k = get_key();
  var dx = 0;
  var dy = 0;
  
  if (k == 37) { dx = 0 - 1; } // Left
  if (k == 39) { dx = 1; }     // Right
  if (k == 38) { dy = 0 - 1; } // Up
  if (k == 40) { dy = 1; }     // Down
  
  if (dx == 0) {
    if (dy == 0) {
       return;
    }
  }
  
  var next_x = player_x + dx;
  var next_y = player_y + dy;
  
  var tile = get_tile(next_x, next_y);
  if (tile != TILE_WALL) {
    player_x = next_x;
    player_y = next_y;
  }
}

func check_goal() {
  if (player_x == goal_x) {
    if (player_y == goal_y) {
       // Reached goal!
       coins = coins + 1;
       level = level + 1;
       
       // Auto-buy upgrades
       if (coins > 5) {
         if (has_monsters == 0) {
            has_monsters = 1;
            coins = coins - 5;
         } else {
            map_complexity = map_complexity + 1;
            coins = coins - 5;
         }
       }
       
       generate_dungeon();
    }
  }
}

// Main
generate_dungeon();

func update() {
  move_player();
  check_goal();
  draw();
  present();
}